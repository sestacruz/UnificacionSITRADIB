<Window x:Class="UnificacionSITRADIB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnificacionSITRADIB"
        xmlns:helpers="clr-namespace:UnificacionSITRADIB.Helpers"
        mc:Ignorable="d"
        Title="Unificador de Archivos SITRADIB" Height="566" Width="1015"
        Background="#f0f0f0">
    <Window.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <helpers:NullToBoolConverter x:Key="NullToBoolConverter"/>
    </Window.Resources>
    <DockPanel Margin="10">
        <!-- Botones arriba -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 10">
            <Button Content="Seleccionar archivos" Command="{Binding SeleccionarArchivosCommand}" Margin="0 0 10 0"/>
            <Button Content="Habilitar edición" Command="{Binding HabilitarEdicionCommand}" Margin="0 0 10 0"/>
            <Button Content="Exportar archivo" Command="{Binding ExportarCommand}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 10">
            <TextBlock Text="CUIT:" FontWeight="Bold" Margin="0 0 5 0"/>
            <TextBlock Text="{Binding Cuit}" Margin="0 0 20 0"/>
            <TextBlock Text="Período:" FontWeight="Bold" Margin="0 0 5 0"/>
            <TextBlock Text="{Binding Periodo}" Margin="0 0 20 0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 10">
            <TextBlock Text="Total empleados:" FontWeight="Bold" Margin="0 0 5 0"/>
            <TextBlock Text="{Binding TotalEmpleados}" Margin="0 0 5 0"/>
            <TextBlock Text="Total sueldos:" FontWeight="Bold" Margin="0 0 5 0"/>
            <TextBlock Text="{Binding TotalSueldos, StringFormat={}{0:C}, ConverterCulture=es-AR}" Margin="0 0 20 0"/>
        </StackPanel>

        <!-- Contenido con Tabs -->
        <TabControl>
            <!-- Tab 1: Archivos -->
            <TabItem Header="Archivos seleccionados">
                <ListBox ItemsSource="{Binding ArchivosSeleccionados}" />
            </TabItem>

            <!-- Tab 2: Empleados -->
            <TabItem Header="Listado de empleados">
                <DataGrid ItemsSource="{Binding Empleados}" SelectedItem="{Binding EmpleadoSeleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CUIL" Binding="{Binding Dni}" Width="150"/>
                        <DataGridTextColumn Header="Cantidad de conceptos" Binding="{Binding Registros.Count}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 3: Detalle del Empleado -->
            <TabItem Header="{Binding TituloDetalleEmpleado}" 
                     IsEnabled="{Binding EmpleadoSeleccionado, Converter={StaticResource NullToBoolConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding EmpleadoSeleccionado.Nombre}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Créditos: " Width="150"/>
                        <TextBlock Text="{Binding EmpleadoSeleccionado.TotalCreditos, StringFormat=C}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Débitos: " Width="150"/>
                        <TextBlock Text="{Binding EmpleadoSeleccionado.TotalDebitos, StringFormat=C}" />
                    </StackPanel>

                    <Separator Margin="0,5"/>

                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Neto a cobrar: " Width="150" FontWeight="Bold"/>
                        <TextBlock Text="{Binding EmpleadoSeleccionado.TotalNeto, StringFormat=C}" FontWeight="Bold"/>
                    </StackPanel>
                    <Separator Margin="0,5"/>
                    <DataGrid ItemsSource="{Binding EmpleadoSeleccionado.Conceptos}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="70"/>
                            <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="2*"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="70"/>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="70"/>
                            <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat={}{0:C}, ConverterCulture=es-AR}" Width="*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Indicador}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Eliminar" Command="{Binding EliminarRegistroCommand}" 
                                IsEnabled="{Binding RegistroSeleccionado, Converter={StaticResource NullToBoolConverter}}" Margin="0 0 10 0"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>


            <!-- Tab 5: Todos los Registros -->
            <TabItem Header="Registros">
                <DataGrid ItemsSource="{Binding Registros}" 
                          AutoGenerateColumns="True"
                          IsReadOnly="{Binding SoloLectura}"
                          Margin="10"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
