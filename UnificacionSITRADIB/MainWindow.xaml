<Window x:Class="UnificacionSITRADIB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnificacionSITRADIB"
        mc:Ignorable="d"
        Title="Unificador de Archivos SITRADIB" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
            <Button x:Name="btnSeleccionarArchivos" Content="Seleccionar Archivos" Width="150" Margin="0 0 10 0" Click="BtnSeleccionarArchivos_Click"/>
            <TextBlock x:Name="txtCantidadArchivos" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid x:Name="dataGridRegistros" Grid.Row="1" AutoGenerateColumns="True" CanUserAddRows="False" />

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button x:Name="btnUnificar" Content="Unificar y Guardar" Width="150" Margin="0 0 10 0" Click="BtnUnificar_Click"/>
            <Button Content="Salir" Width="80" Click="BtnSalir_Click"/>
        </StackPanel>
    </Grid>
</Window>
